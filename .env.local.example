# =============================================================================
# VELORA — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# All variables without NEXT_PUBLIC_ prefix are server-side only.

# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Strava OAuth2
# Register your app at: https://www.strava.com/settings/api
# Redirect URI must match exactly what you register with Strava.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# -----------------------------------------------------------------------------
# Whoop OAuth2
# Register your app at: https://developer.whoop.com
# -----------------------------------------------------------------------------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# -----------------------------------------------------------------------------
# Garmin Connect (unofficial — credentials, not OAuth)
# These are your personal Garmin account credentials.
# Server-side only — never exposed to the client.
# -----------------------------------------------------------------------------
GARMIN_EMAIL=
GARMIN_PASSWORD=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
