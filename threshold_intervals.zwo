<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>VELORA</author>
  <name>Threshold Intervals</name>
  <description>5x3min at threshold</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75"/>
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="90" OnPower="1.05" OffPower="0.55"/>
    <Cooldown Duration="600" PowerLow="0.75" PowerHigh="0.25"/>
  </workout>
</workout_file>