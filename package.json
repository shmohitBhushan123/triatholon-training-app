{
  "name": "triatholon-training-app",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "lint-staged": {
